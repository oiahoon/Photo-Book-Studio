{
  "name": "photo-book-studio",
  "version": "0.1.0",
  "description": "Local-first photo library with Codex analysis handoff",
  "scripts": {
    "build": "vite build",
    "start": "node apps/local-service/server.mjs",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "photos:import": "node scripts/project.mjs import",
    "photos:rotate": "node scripts/project.mjs rotate",
    "analysis:task": "node scripts/project.mjs task",
    "analysis:import": "node scripts/project.mjs analysis-import",
    "project:inspect": "node scripts/project.mjs inspect",
    "excire:snapshot": "node scripts/excire-snapshot.mjs",
    "curation:import": "node scripts/project.mjs external-import",
    "browser:dev": "npm run browser:build && npm run browser:preview",
    "browser:build": "vite build --config vite.browser.config.ts",
    "browser:preview": "vite preview --config vite.browser.config.ts --host 127.0.0.1 --port 4318",
    "browser:analysis:export": "node scripts/browser-analysis-export.mjs",
    "browser:book:export": "node scripts/browser-book-export.mjs",
    "public:check": "node scripts/check-public.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "exifr": "^7.1.3",
    "get-nonce": "^1.0.1",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.57.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2"
  }
}
